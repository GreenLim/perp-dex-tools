@startuml
title Backpack-Lighter 对冲模式主流程
skinparam activity {
  BackgroundColor #f5faff
  BorderColor #2f6b9a
  ArrowColor #2f6b9a
  FontSize 12
}

start
:hedge_mode.py 解析参数 / 加载 .env;
:实例化 HedgeBot 并调用 run();
:initialize_backpack_client();
:initialize_lighter_client();
:获取合约信息与精度参数;
:订阅 Backpack 订单/深度 WS;
:订阅 Lighter 订单簿 WS;

repeat
  :Step 1\nBackpack BUY POST_ONLY;
  if (成交回调?) then (是)
    :handle_backpack_order_update()\n设置 waiting_for_lighter_fill;
    :place_lighter_market_order(SELL);
    :monitor_lighter_order();
  else (否)
    :等待或重试撤单;
  endif

  :Step 2\nBackpack SELL POST_ONLY;
  if (成交回调?) then (是)
    :place_lighter_market_order(BUY);
    :monitor_lighter_order();
  else (否)
    :等待或重试撤单;
  endif

  :Step 3\n若剩余仓位 \u2260 0，按方向\n再次 Backpack POST_ONLY;
  if (成交回调?) then (是)
    :place_lighter_market_order(对冲方向);
    :monitor_lighter_order();
  else (否)
    :等待或重试撤单;
  endif

repeat while (迭代次数 < --iter 且未 stop)

:输出日志 / CSV;
:shutdown() 关闭 WS;
stop
@enduml
