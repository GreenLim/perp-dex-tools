@startuml
title perp-dex-tools 模块结构
skinparam packageStyle rectangle
skinparam componentStyle rectangle
skinparam defaultTextAlignment center

package "CLI & Entry" {
  component "runbot.py" as RunBot
  component "hedge_mode.py" as HedgeEntry
}

package "Core Trading" {
  class TradingBot
  class TradingConfig
  class OrderMonitor
}

interface BaseExchangeClient
class ExchangeFactory

package "Exchange Clients" {
  component EdgeXClient
  component BackpackClient
  component ParadexClient
  component AsterClient
  component GrvtClient
  component ExtendedClient
  component ApexClient
  component LighterClient
}

package "Helpers & Notifications" {
  component TradingLogger
  component TelegramBot
  component LarkBot
}

package "Hedge Implementations" {
  component "hedge_mode_bp.py" as HedgeBP
  component "hedge_mode_ext.py" as HedgeEXT
  component "hedge_mode_apex.py" as HedgeApex
  component "hedge_mode_grvt.py" as HedgeGRVT
  component "hedge_mode_edgex.py" as HedgeEdgeX
}

RunBot --> TradingConfig
RunBot --> TradingBot
TradingBot --> ExchangeFactory
TradingBot --> TradingLogger
TradingBot --> TelegramBot
TradingBot --> LarkBot
TradingBot --> OrderMonitor

ExchangeFactory --> BaseExchangeClient
ExchangeFactory --> EdgeXClient
ExchangeFactory --> BackpackClient
ExchangeFactory --> ParadexClient
ExchangeFactory --> AsterClient
ExchangeFactory --> GrvtClient
ExchangeFactory --> ExtendedClient
ExchangeFactory --> ApexClient
ExchangeFactory --> LighterClient

HedgeEntry --> HedgeBP
HedgeEntry --> HedgeEXT
HedgeEntry --> HedgeApex
HedgeEntry --> HedgeGRVT
HedgeEntry --> HedgeEdgeX

HedgeBP --> BackpackClient
HedgeBP --> LighterClient
HedgeEXT --> ExtendedClient
HedgeEXT --> LighterClient
HedgeApex --> ApexClient
HedgeApex --> LighterClient
HedgeGRVT --> GrvtClient
HedgeGRVT --> LighterClient
HedgeEdgeX --> EdgeXClient
HedgeEdgeX --> LighterClient

@enduml
